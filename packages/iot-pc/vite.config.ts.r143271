import vue from '@vitejs/plugin-vue'
import vueJsx from '@vitejs/plugin-vue-jsx'
import path from 'node:path'
import { fileURLToPath, URL } from 'node:url'
import { presetIcons } from 'unocss'
import Unocss from 'unocss/vite'
import AutoImport from 'unplugin-auto-import/vite'
import IconsResolver from 'unplugin-icons/resolver'
import Icons from 'unplugin-icons/vite'
import { ElementPlusResolver } from 'unplugin-vue-components/resolvers'
import Components from 'unplugin-vue-components/vite'
import { defineConfig, loadEnv } from 'vite'
import { injectHtml } from 'vite-plugin-html'
import { createSvgIconsPlugin } from 'vite-plugin-svg-icons'
import loading from './sk/loading'
import CopyAfterBuild from '../plugin/vite-plugin-copy-after-build'
import { visualizer } from 'rollup-plugin-visualizer'

const OUTPUT = './output'
const ENV_DIR = './envs'

export default ({ mode }: any) => {
  process.env = { ...process.env, ...loadEnv(mode, path.resolve(process.cwd(), ENV_DIR)) }

  const APP_TYPE = process.env.VITE_APP_TYPE

  return defineConfig({
    base: '/' + (process.env.VITE_APP_WEB_PREFIX || ''),
    envDir: ENV_DIR,
    server: {
      host: '0.0.0.0',
      port: 8008,
      proxy: {
        '/api': {
          target: 'http://192.168.1.33:8999/iot-api',
          // target: 'http://192.168.0.25:9998',
          // target: 'http://47.97.123.179:55157/iot-api',
          secure: false,
          changeOrigin: true,
          rewrite: (path) => path.replace(/^\/api/, '')
        },
        //  图片资源代理
        '/oss': {
          target: 'http://47.97.123.179:9000/',
          secure: false,
          changeOrigin: true,
          rewrite: (path) => {
            return path.replace(/^\/oss/, '')
          }
        }
      }
    },
    preview: {
      proxy: {
        '/iot-api': {
          target: 'http://192.168.0.44:9998',
          secure: false,
          changeOrigin: true
        }
      }
    },
    build: {
      emptyOutDir: true,
      outDir: '../../dist/pc',
      rollupOptions: {
        external:
          APP_TYPE === 'dmzn'
            ? (id) => {
                // TODO: 绝大多数可由 main.ts 中处理导入
                // const externalPackages = [
                //   '@ffmpeg/ffmpeg',
                //   '@ffmpeg/util',
                //   '@ffmpeg/core',
                //   'xgplayer',
                //   'jessibuca',
                //   'v-network-graph'
                // ]

                // if (externalPackages.includes(id)) {
                //   return true
                // }

                const localComponents = ['src/components/drawing', 'src/components/media']

                if (localComponents.some((comp) => id.includes(comp))) return true

                return false
              }
            : undefined
      }
    },
    esbuild: {
      drop: mode === 'dev' || mode === 'debug' ? [] : ['console', 'debugger']
    },
    optimizeDeps: {
      exclude: ['@ffmpeg/ffmpeg', '@ffmpeg/util', '@ffmpeg/core']
    },
    css: {
      preprocessorOptions: {
        scss: {
          api: 'legacy',
          silenceDeprecations: ['legacy-js-api']
        }
      }
    },
    plugins: [
      vue(),
      vueJsx(),
      createSvgIconsPlugin({
        iconDirs: [path.resolve(process.cwd(), 'src/icons')],
        symbolId: 'icon-[name]'
      }),
      AutoImport({
        imports: ['vue', 'vue-router'],
        dts: path.resolve(__dirname, OUTPUT, 'dts/auto-import.d.ts')
      }),
      Components({
        dts: path.resolve(__dirname, OUTPUT, 'dts/components.d.ts'),
        resolvers: [
          IconsResolver({
            // prefix: false,
            enabledCollections: ['ep']
          }),
          ElementPlusResolver()
        ]
      }),
      injectHtml({
        injectData: {
          sk: loading(process.env.VITE_APP_THEME_COLOR),
          title: process.env.VITE_APP_TITLE,
          jessibuca: APP_TYPE === 'dmzn' ? '' : '<script src="/jessibuca/jessibuca.js"></script>'
        }
      }),
      Icons({ autoInstall: true }),
      Unocss({
        presets: [
          presetIcons({
            scale: 1.2,
            warn: true
          })
        ],
        //<i-ep-xx />
        variants: [
          {
            match: (s) => {
              if (s.startsWith('i-')) {
                return {
                  matcher: s,
                  selector: (s) => {
                    return s.startsWith('.') ? `${s.slice(1)},${s}` : s
                  }
                }
              }
            }
          }
        ]
      }),
      CopyAfterBuild({ mode }),
      visualizer({ filename: `${OUTPUT}/stats.html` })
    ],
    resolve: {
      alias: {
        '@': fileURLToPath(new URL('./src', import.meta.url)),
        plugin: fileURLToPath(new URL('../plugin', import.meta.url))
      }
    },
    define: {
      __tools: 'window.__arc_pc_tools',
      __appType: JSON.stringify(process.env.VITE_APP_TYPE),
      __appTitle: JSON.stringify(process.env.VITE_APP_TITLE)
    }
  })
}
