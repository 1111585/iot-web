{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "element-plus/global"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "plugin/*": ["../plugin/*"]
    },
    "noImplicitAny": false,
    "noEmit": true,
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "./*.d.ts",
    "src/util/**/*",
    "src/types/**/*",
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "sk/*",
    "../plugin/*",
    "src/types/vite-env.d.ts",
    "output/dts/*.d.ts"
  ],
  "exclude": ["src/**/__tests__/*"]
}
